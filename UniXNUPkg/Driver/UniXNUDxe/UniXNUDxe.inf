## @file
#  Firmware integration of UniXNU: a registrar DXE driver.
#
#  Put this driver and UniXNUPkg/Application/UniXNU/UniXNU.inf in the
#  same firmware volume. When dispatched, the driver registers a Boot####
#  option for the UniXNU application file in that FV and moves it to the
#  front of BootOrder, so the platform BDS starts UniXNU like any other
#  boot manager (BDS only boots EFI_APPLICATION images). The option carries
#  "unixnu:firmware" as optional data, which tells the application it was
#  started by firmware.
#
#  Copyright (c) 2026, UniXNU contributors. All rights reserved.
#  SPDX-License-Identifier: BSD-2-Clause-Patent
##

[Defines]
  INF_VERSION    = 0x00010019
  BASE_NAME      = UniXNUDxe
  FILE_GUID      = 29B950CF-586D-49EA-9D71-F88645CCDAF6
  MODULE_TYPE    = DXE_DRIVER
  VERSION_STRING = 0.1
  ENTRY_POINT    = UniXNUDxeEntry

[Sources]
  UniXNUDxe.c

[Packages]
  MdePkg/MdePkg.dec
  UniXNUPkg/UniXNUPkg.dec

[LibraryClasses]
  BaseLib
  BaseMemoryLib
  DebugLib
  DevicePathLib
  MemoryAllocationLib
  PcdLib
  PrintLib
  UefiBootServicesTableLib
  UefiDriverEntryPoint
  UefiLib
  UefiRuntimeServicesTableLib

[Guids]
  gEfiGlobalVariableGuid              ## SOMETIMES_PRODUCES ## Variable:L"Boot####" L"BootOrder"

[Protocols]
  gEfiFirmwareVolume2ProtocolGuid     ## CONSUMES
  gEfiLoadedImageProtocolGuid         ## CONSUMES

[Pcd]
  gUniXNUPkgTokenSpaceGuid.PcdUniXNUApplicationFile

[Depex]
  #
  # TRUE while the boot chain is being brought up. The original expression waits
  # for the variable arch and variable write arch protocols, which come from
  # VariableRuntimeDxe. On the unit the platform stops after RamManagerDxe with
  # the last DXE line still on the panel and never reaches BDS, which is exactly
  # what an unsatisfied Depex looks like from the outside. Running unconditionally
  # says whether this driver is the one holding the dispatch loop.
  #
  # Restore gEfiVariableArchProtocolGuid AND gEfiVariableWriteArchProtocolGuid
  # once the menu appears.
  #
  TRUE
